{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["mcp/**/*.ts", "scripts/**/*.ts", "audit/**/*.ts", "competitors/**/*.ts", "card/**/*.ts", "office/**/*.ts", "vitest.config.ts"]
}
