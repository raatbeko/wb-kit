{
  "permissions": {
    "allow": [
      "mcp__wb",
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run set-key:*)",
      "Bash(npm run audit)",
      "Bash(npm run audit:*)",
      "Bash(npm run competitors:*)",
      "Bash(npm run card:*)",
      "Bash(npm run office:*)",
      "Write(./reports/**)",
      "Edit(./reports/**)",
      "Bash(npm install)",
      "Bash(npm test)"
    ],
    "ask": [
      "mcp__wb__update_prices",
      "mcp__wb__update_fbs_stocks",
      "mcp__wb__create_fbs_supply",
      "mcp__wb__add_orders_to_fbs_supply",
      "mcp__wb__deliver_fbs_supply",
      "mcp__wb__reply_feedback",
      "mcp__wb__reply_question"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx \"$CLAUDE_PROJECT_DIR/office/hooks/event.ts\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
