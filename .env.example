# Ключи wb-kit. Скопируйте этот файл в .env (команда /setup сделает это сама)
# и вставьте ключи после знака «=» без кавычек и пробелов.
# Файл .env не попадает в git и никуда не отправляется.

# Обязательно. Ключ API Wildberries.
# Кабинет WB → Настройки → Доступ к API → Создать новый токен.
# Для начала хватит ключа «Только на чтение» со всеми категориями.
WB_API_TOKEN=

# По желанию. Токен MPSTATS: аналитика конкурентов и ниш, генерация фото карточек.
# mpstats.io/userpanel → блок «API token». Работает только с платной подпиской MPSTATS.
MPSTATS_TOKEN=

# По желанию, для Telegram-бота 24/7 (фаза 5).
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
